# ─────────────────────────────────────────────────────────────
# BLOSSOM Magazine — Environment Configuration
# This file is a TEMPLATE. Copy it to `.env` or use the web
# installer (visit the site root and follow the wizard) which
# auto-detects your domain and writes a correct `.env` for you.
# ─────────────────────────────────────────────────────────────

APP_NAME="BLOSSOM Magazine"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos
# Set by the installer automatically — your site's public URL.
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────
# The installer defaults to SQLite (zero configuration). For
# production, MySQL/Postgres are recommended — uncomment the
# matching block and set DB_CONNECTION accordingly.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=blossom
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_DRIVER=database

CACHE_DRIVER=file

# ── Mail ──────────────────────────────────────────────────────
# For production use a transactional provider (Mailgun, Postmark,
# SendGrid, SES, etc.) — Gmail SMTP is not suitable for volume.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@blossom.ng"
MAIL_FROM_NAME="${APP_NAME}"

# ── Payments ─────────────────────────────────────────────────
# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Monnify
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_SUBACCOUNT_CODE=

# Nomba
NOMBA_API_KEY=
NOMBA_SECRET_KEY=
NOMBA_MERCHANT_ID=

# ── Support Chatbot ──────────────────────────────────────────
# OpenRouter (LLM responses for the support chatbot)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# respond.io (WhatsApp / Telegram / Voice support channels)
RESPONDIO_API_KEY=
RESPONDIO_WORKSPACE=
RESPONDIO_WEBHOOK_SECRET=